{
  "name": "@agentclinic/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "prelint": "npm run prisma:generate",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit --incremental false",
    "pretest": "npm run prisma:generate",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^12.0.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.9",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
