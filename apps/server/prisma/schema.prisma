generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Agent {
  id      String @id
  name    String
  model   String
  summary String

  @@index([name, id])
}

model Ailment {
  id          String @id
  name        String
  summary     String
  description String
  therapies   Therapy[]

  @@index([name, id])
}

model Therapy {
  id          String @id
  name        String @unique
  summary     String
  description String
  ailments    Ailment[]

  @@index([name, id])
}
