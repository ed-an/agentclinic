generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Agent {
  id           String        @id
  name         String
  model        String
  summary      String
  appointments Appointment[]
  userAccount  UserAccount?

  @@index([name, id])
}

model UserAccount {
  id           String        @id
  email        String        @unique
  passwordHash String
  role         String
  agentId      String?       @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  sessions     AuthSession[]

  @@index([role, isActive])
}

model AuthSession {
  id            String      @id
  accountId     String
  tokenHash     String      @unique
  csrfTokenHash String      @unique
  createdAt     DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  account       UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
}

model Ailment {
  id          String    @id
  name        String
  summary     String
  description String
  therapies   Therapy[]

  @@index([name, id])
}

model Therapy {
  id                String             @id
  name              String             @unique
  summary           String
  description       String
  ailments          Ailment[]
  availabilitySlots AvailabilitySlot[]

  @@index([name, id])
}

model AvailabilitySlot {
  id              String       @id
  therapyId       String
  startsAt        DateTime
  durationMinutes Int
  isAvailable     Boolean
  therapy         Therapy      @relation(fields: [therapyId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([therapyId, startsAt])
  @@index([therapyId, isAvailable, startsAt, id])
}

model Appointment {
  id                 String           @id
  availabilitySlotId String
  agentId            String
  visitorName        String
  visitorEmail       String
  status             String           @default("PENDING")
  cancelledAt        DateTime?
  cancellationSource String?
  cancellationReasonCode String?
  idempotencyKey     String           @unique
  createdAt          DateTime         @default(now())
  availabilitySlot   AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  agent              Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  statusEvents       AppointmentStatusEvent[]

  @@index([agentId])
  @@index([agentId, status])
  // SQLite active-booking uniqueness is enforced by the partial index
  // Appointment_one_active_per_slot in the Phase 9 SQL migration. Prisma
  // cannot represent partial indexes; future migrations must preserve it.
}

model AppointmentStatusEvent {
  id            String      @id
  appointmentId String
  fromStatus    String?
  toStatus      String
  actorType     String
  reasonCode    String?
  createdAt     DateTime
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt, id])
}
