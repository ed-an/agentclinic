generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Agent {
  id      String @id
  name    String
  model   String
  summary String

  @@index([name, id])
}

model Ailment {
  id          String @id
  name        String
  summary     String
  description String

  @@index([name, id])
}
