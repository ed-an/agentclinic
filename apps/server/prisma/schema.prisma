generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Agent {
  id           String        @id
  name         String
  model        String
  summary      String
  appointments Appointment[]

  @@index([name, id])
}

model Ailment {
  id          String    @id
  name        String
  summary     String
  description String
  therapies   Therapy[]

  @@index([name, id])
}

model Therapy {
  id                String             @id
  name              String             @unique
  summary           String
  description       String
  ailments          Ailment[]
  availabilitySlots AvailabilitySlot[]

  @@index([name, id])
}

model AvailabilitySlot {
  id              String       @id
  therapyId       String
  startsAt        DateTime
  durationMinutes Int
  isAvailable     Boolean
  therapy         Therapy      @relation(fields: [therapyId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([therapyId, startsAt])
  @@index([therapyId, isAvailable, startsAt, id])
}

model Appointment {
  id                 String           @id
  availabilitySlotId String
  agentId            String
  visitorName        String
  visitorEmail       String
  status             String           @default("CONFIRMED")
  cancelledAt        DateTime?
  idempotencyKey     String           @unique
  createdAt          DateTime         @default(now())
  availabilitySlot   AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  agent              Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agentId])
  @@index([agentId, status])
  // SQLite active-booking uniqueness is enforced by the partial index
  // Appointment_one_confirmed_per_slot in the Phase 8 SQL migration. Prisma
  // cannot represent partial indexes; future migrations must preserve it.
}
