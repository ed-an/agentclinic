NODE_ENV=production
PORT=3001
DATABASE_URL=file:/data/agentclinic.db
AGENTCLINIC_WEB_ORIGIN=https://replace-with-approved-domain.invalid
AGENTCLINIC_API_URL=https://replace-with-approved-api-domain.invalid
AGENTCLINIC_TIME_ZONE=America/Sao_Paulo
AGENTCLINIC_CANCELLATION_CUTOFF_HOURS=24
AGENTCLINIC_HTTPS=true
AGENTCLINIC_TRUST_PROXY=false
AGENTCLINIC_SHUTDOWN_TIMEOUT_MS=10000
AGENTCLINIC_INSTANCE_COUNT=1
AGENTCLINIC_SQLITE_WRITER=single
# Secrets are intentionally omitted. Inject them through the approved secret mechanism.
