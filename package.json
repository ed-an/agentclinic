{
  "name": "agentclinic",
  "version": "0.1.0",
  "description": "A welcoming clinic for AI agents",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace @agentclinic/server",
    "dev:web": "npm run dev --workspace @agentclinic/web",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:validation",
    "test:validation": "npm run test --workspaces --if-present",
    "test:browser": "npm run test:browser --workspace @agentclinic/web",
    "build": "npm run build --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:validation && npm run build && npm run smoke && npm run test:browser"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
