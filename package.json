{
  "name": "agentclinic",
  "version": "0.1.0",
  "description": "A welcoming clinic for AI agents",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace @agentclinic/server",
    "dev:web": "npm run dev --workspace @agentclinic/web",
    "prisma:generate": "npm run prisma:generate --workspace @agentclinic/server",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @agentclinic/server",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @agentclinic/server",
    "db:seed": "npm run db:seed --workspace @agentclinic/server",
    "db:reset": "npm run db:reset --workspace @agentclinic/server",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:validation",
    "test:validation": "npm run test --workspaces --if-present",
    "test:browser": "npm run test:browser --workspace @agentclinic/web",
    "build": "npm run build --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs",
    "backup:sqlite": "node scripts/sqlite-ops.mjs backup",
    "restore:sqlite": "node scripts/sqlite-ops.mjs restore",
    "test:backup-restore": "node --test scripts/sqlite-ops.test.mjs",
    "performance:validate": "node scripts/performance.mjs",
    "test:operations": "node scripts/operational-smoke.mjs",
    "test:production-readiness": "npm run test:operations && npm run test:backup-restore && npm run performance:validate",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:validation && npm run build && npm run smoke && npm run test:browser"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
