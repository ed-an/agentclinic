# Relative SQLite paths are resolved from apps/server when npm workspace commands run.
DATABASE_URL="file:./prisma/dev.db"

# Server-rendered appointment times use this IANA timezone.
AGENTCLINIC_TIME_ZONE="America/Sao_Paulo"

# Confirmed appointments can be cancelled at or before this many hours remain.
AGENTCLINIC_CANCELLATION_CUTOFF_HOURS="24"

# Production must set one or more exact trusted HTTPS origins.
AGENTCLINIC_WEB_ORIGIN="http://localhost:3000"

# Set true only when production TLS termination is correctly configured.
AGENTCLINIC_HTTPS="false"

# Proxy headers are ignored by default; "loopback" is the only supported opt-in.
AGENTCLINIC_TRUST_PROXY="false"

# Graceful shutdown completes or fails within this bound.
AGENTCLINIC_SHUTDOWN_TIMEOUT_MS="10000"
