# Relative SQLite paths are resolved from apps/server when npm workspace commands run.
DATABASE_URL="file:./prisma/dev.db"

# Server-rendered appointment times use this IANA timezone.
AGENTCLINIC_TIME_ZONE="America/Sao_Paulo"

# Confirmed appointments can be cancelled at or before this many hours remain.
AGENTCLINIC_CANCELLATION_CUTOFF_HOURS="24"
